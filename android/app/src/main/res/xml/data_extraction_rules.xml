<!--
  File Purpose: Prevents local game state from entering cloud backup or device transfer.
  Primary Components: Cloud-backup and device-transfer exclusions.
  Inputs/Outputs: Read by Android 12+ backup services; excludes all app-private files.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
